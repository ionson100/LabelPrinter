<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Демонстрация того, что библиотека подключается к чужому приложению «без труда».
    Приложение — обычная консоль на .NET 9, то есть другая платформа, не та,
    на которой писалась библиотека. Если это собралось и работает, значит
    LabelPrinter.Core действительно самодостаточна.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>LabelPrinter.Core.Sample</AssemblyName>
    <RootNamespace>LabelPrinter.Core.Sample</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LabelPrinter.Core\LabelPrinter.Core.csproj" />
  </ItemGroup>

</Project>